{
  // Cloudflare Workers の設定。public/ の中身をそのまま配信し、
  // /api/contact だけ src/worker.js が受けてメールを送る
  "name": "sakaino-bankin-web",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // 送信先は Cloudflare 側の変数 CONTACT_TO（Email Routing で確認済みのアドレス）
  "send_email": [{ "name": "SEND_EMAIL" }],
  // ダッシュボードで設定した変数（CONTACT_TO）をデプロイ時に消さない
  "keep_vars": true
}
